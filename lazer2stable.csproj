<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>lazer2stable</AssemblyName>
    <RootNamespace>Lazer2Stable</RootNamespace>
    <Version>2.5.0</Version>
    <Product>lazer2stable</Product>
    <Company>Exotique</Company>
    <Authors>Exotique</Authors>
    <Copyright>© 2026 Exotique</Copyright>
    <Description>lazer2stable: copies the osu!lazer beatmaps, scores and skins missing from osu!stable.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Même version de Realm que osu! lazer (osu.Game.csproj), pour lire son format de base. -->
    <RealmVersion>20.1.0</RealmVersion>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <AvaloniaXaml Remove="tests/**" />
    <None Remove="tests/**" />
    <AvaloniaResource Include="Assets/**" />
    <InternalsVisibleTo Include="Screens" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Realm" Version="$(RealmVersion)" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
</Project>
